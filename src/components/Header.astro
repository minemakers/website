---
import Logo from './Logo.astro';
import { SITE } from '~/lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href.replace(/\/$/, ''));
const [left, right] = SITE.nav;
---

<header class="site-header">
  <nav aria-label="Main">
    <a class="link left" href={left.href} aria-current={isActive(left.href) ? 'page' : undefined}>{left.label}</a>
    <a class="logo" href="/" aria-label="MineMakers home">
      <span class="diamond"><Logo /></span>
    </a>
    <a class="link right" href={right.href} aria-current={isActive(right.href) ? 'page' : undefined}>{right.label}</a>
  </nav>
</header>

<style>
  /* Same idea as the original site: MAPS ◆ TEAM, with the diamond hanging below the bar. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: #0b0d12;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.06), 0 8px 24px -12px rgb(0 0 0 / 0.8);
  }
  nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    /* Row stays the bar's height; the larger diamond overflows it equally above and below. */
    grid-template-rows: 100%;
    align-items: center;
    height: 100%;
    max-width: 36rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .link {
    padding: 0.5rem 1.25rem;
    color: #d8dae0;
    font: 600 1.5rem / 1 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      color 0.2s,
      transform 0.3s;
  }
  .left {
    justify-self: end;
  }
  .right {
    justify-self: start;
  }
  .link:hover {
    color: #fff;
  }
  .left:hover {
    transform: translateX(-6px);
  }
  .right:hover {
    transform: translateX(6px);
  }
  .link {
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  .link[aria-current='page'] {
    color: #fff;
  }
  .logo {
    position: relative;
    /* Centred on the bar, so the diamond's side corners line up with the middle of MAPS / TEAM.
       The top point tucks past the top of the window, the bottom point hangs below the bar. */
    top: 0;
    display: block;
    width: 5.25rem;
    height: 5.25rem;
    margin-inline: var(--space-l);
    transform: rotate(45deg);
    filter: drop-shadow(0 6px 8px rgb(0 0 0 / 0.55));
  }
  .diamond {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.5s ease;
  }
  .diamond :global(img) {
    width: 100%;
    height: 100%;
  }
  .logo:hover .diamond,
  .logo:focus-visible .diamond {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .logo:hover .diamond,
    .left:hover,
    .right:hover {
      transform: none;
    }
  }
  @media (max-width: 26rem) {
    .link {
      padding-inline: 0.6rem;
      font-size: 1.25rem;
      letter-spacing: 0.1em;
    }
    .logo {
      width: 4.25rem;
      height: 4.25rem;
      margin-inline: var(--space-xs);
    }
  }
</style>
