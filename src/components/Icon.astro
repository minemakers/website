---
/** UI icons (24×24 stroke) plus brand marks from simple-icons. */
import { siYoutube, siTwitch, siGithub, siCurseforge } from 'simple-icons';

const stroke = {
  download: '<path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 20h14"/>',
  external: '<path d="M14 5h5v5M19 5l-8 8M17 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h4"/>',
  arrow: '<path d="M5 12h14m0 0-6-6m6 6-6 6"/>',
  back: '<path d="M19 12H5m0 0 6-6m-6 6 6 6"/>',
  cube: '<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm-8 4.5 8 4.5 8-4.5M12 12v9"/>',
} as const;

const brands = {
  youtube: siYoutube,
  twitch: siTwitch,
  github: siGithub,
  curseforge: siCurseforge,
} as const;

export type IconName = keyof typeof stroke | keyof typeof brands;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className, label } = Astro.props;
const brand = name in brands ? brands[name as keyof typeof brands] : undefined;
const role = label ? 'img' : undefined;
const hidden = label ? undefined : ('true' as const);
---

{
  brand ? (
    <svg class={className} width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor" role={role}
      aria-label={label}
      aria-hidden={hidden}>
      <path d={brand.path} />
    </svg>
  ) : (
    <svg
      class={className}
      width="1em"
      height="1em"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      role={role}
      aria-label={label}
      aria-hidden={hidden}
      set:html={stroke[name as keyof typeof stroke]}
    />
  )
}
