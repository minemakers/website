---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import { Image } from 'astro:assets';
import { getAvatar } from '~/lib/files';
import { orderOf } from '~/lib/maps';

const members = await Promise.all(
  (await getCollection('members'))
    .sort((a, b) => orderOf(a) - orderOf(b))
    .map(async (m) => ({ ...m, Content: (await render(m)).Content })),
);
---

<Base title="Team" description="Everyone who contributed to MineMakers maps over the years.">
  <header class="page-head container">
    <p class="eyebrow">The team</p>
    <h1>The people behind the maps</h1>
    <p>
      MineMakers was a group of friends making Minecraft maps together. Everyone here contributed at some point. The
      team is mostly inactive now.
    </p>
  </header>

  <ul class="container members">
    {
      members.map(({ id, data, Content }) => (
        <li class="member">
          <Image src={getAvatar(id)} alt="" class="avatar" widths={[160, 320]} sizes="160px" />
          <div>
            <h2>{data.name}</h2>
            <div class="bio">
              <Content />
            </div>
          </div>
        </li>
      ))
    }
  </ul>

</Base>

<style>
  .page-head {
    padding-block: var(--space-2xl) var(--space-xl);
  }
  .page-head h1 {
    font-size: var(--step-4);
    margin-block: var(--space-2xs) var(--space-s);
  }
  .page-head p:not(.eyebrow) {
    color: var(--text-muted);
    font-size: var(--step-1);
    max-width: 56ch;
  }
  .members {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l);
    list-style: none;
    padding-left: 0;
  }
  .member {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-m);
    align-items: start;
    padding: var(--space-s);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
  }
  .member :global(.avatar) {
    width: 9rem;
    height: 9rem;
    object-fit: cover;
    border-radius: var(--radius-m);
  }
  .member > div {
    padding-block: var(--space-2xs);
  }
  h2 {
    font-size: clamp(1.45rem, 1.25rem + 0.9vw, 1.9rem);
    margin-bottom: var(--space-xs);
  }
  .bio {
    display: grid;
    gap: var(--space-xs);
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .page-head a {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  /* Always two columns on wide screens, one on narrow ones. */
  @media (max-width: 52rem) {
    .members {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 26rem) {
    .member {
      grid-template-columns: 6.5rem 1fr;
      gap: var(--space-s);
    }
    .member :global(.avatar) {
      width: 6.5rem;
      height: 6.5rem;
    }
  }
</style>
